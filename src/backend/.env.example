# Backend configuration. Copy to `.env` and adjust as needed.

# Postgres connection (SQLAlchemy URL, psycopg3 driver).
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/quotes

# Embedding model. Runs on CPU by default (fine for this small model).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Comma-separated list of allowed CORS origins for the frontend.
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080

# Max quotes to fetch per source during ingestion (0 = no limit where supported).
INGEST_QUOTABLE_LIMIT=1500
INGEST_BIBLE_ENABLED=true
